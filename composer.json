{
    "name": "webpatser/resonate",
    "description": "Fiber-based WebSocket server for PHP 8.6: a drop-in replacement for Laravel Reverb, built on fledge-fiber",
    "keywords": ["laravel", "websockets", "reverb", "pusher", "fibers", "broadcasting", "fledge"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Christoph Kempen",
            "email": "christoph@downsized.nl"
        }
    ],
    "require": {
        "php": "^8.6",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "webpatser/fledge-fiber": "^13.43.0.3",
        "webpatser/fledge-loop": "^0.1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "laravel/pulse": "^1.0",
        "open-telemetry/api": "^1.10",
        "open-telemetry/sdk": "^1.17",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.2",
        "pusher/pusher-php-server": "^7.2"
    },
    "suggest": {
        "open-telemetry/api": "Required for the opt-in OpenTelemetry metrics plugin (RESONATE_OTEL_METRICS)",
        "webpatser/fledge-apm": "Provides the OpenTelemetry meter provider and exporter the metrics plugin reports to"
    },
    "autoload": {
        "psr-4": {
            "Webpatser\\Resonate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webpatser\\Resonate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webpatser\\Resonate\\ResonateServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php -d zend.assertions=1 -d assert.exception=1 vendor/bin/pest",
        "lint": "pint --test",
        "analyse": "@php -d memory_limit=-1 vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
